{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/testowyemailaplikacja-spec/CcnaLab/blob/develop/schemas/ccna-lesson.schema.json",
  "title": "CCNAlab Lesson Contract v1",
  "description": "Authoring-only schema. Not wired into current UI until separate gated migration. Machine validation in scripts/validate-ccna-lesson.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "sectionId",
    "titleEn",
    "source",
    "sourceNote",
    "expandedNote",
    "objectives",
    "cards",
    "laboratory"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 2
    },
    "sectionId": {
      "type": "string",
      "minLength": 2
    },
    "titleEn": {
      "type": "string",
      "minLength": 2
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "title",
        "verified",
        "rightsReviewed"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "verified": {
          "const": true
        },
        "rightsReviewed": {
          "const": true
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "sourceNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "start",
              "end",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "start": {
                "type": "string",
                "pattern": "^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$"
              },
              "end": {
                "type": "string",
                "pattern": "^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$"
              },
              "text": {
                "type": "string",
                "minLength": 3
              }
            }
          }
        }
      }
    },
    "expandedNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocks"
      ],
      "properties": {
        "blocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "headingEn",
              "markdown"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "headingEn": {
                "type": "string",
                "minLength": 2
              },
              "markdown": {
                "type": "string",
                "minLength": 10
              }
            }
          }
        }
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "sourceBlockIds",
          "noteBlockIds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 5
          },
          "sourceBlockIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "noteBlockIds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "objectiveId",
          "noteBlockId",
          "question",
          "options",
          "correctIndex",
          "explanation"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "objectiveId": {
            "type": "string"
          },
          "noteBlockId": {
            "type": "string"
          },
          "question": {
            "type": "string",
            "minLength": 10
          },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "correctIndex": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "explanation": {
            "type": "string",
            "minLength": 10
          },
          "questionEn": {
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "archived"
            ]
          }
        }
      }
    },
    "laboratory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "titleEn",
        "sourceUrl",
        "commands",
        "steps",
        "positiveChecks",
        "negativeChecks",
        "packetTracerLink"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "titleEn": {
          "type": "string",
          "minLength": 3
        },
        "sourceUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "device",
              "mode",
              "command",
              "expected"
            ],
            "properties": {
              "device": {
                "type": "string"
              },
              "mode": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "expected": {
                "type": "string"
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "positiveChecks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "negativeChecks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 5
          }
        },
        "packetTracerLink": {
          "type": [
            "string",
            "null"
          ]
        },
        "noCli": {
          "type": "boolean"
        },
        "topology": {
          "type": "string"
        }
      }
    }
  }
}
